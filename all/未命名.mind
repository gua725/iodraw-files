{"root":{"data":{"text":"机台软件变更管理 Phase 总流程图"},"children":[{"data":{"text":"Phase 0"},"children":[{"data":{"text":"变更需求立项（T-14 天启动）"},"children":[{"data":{"text":"配色分类：准备阶段（低饱和度淡蓝色 🩵）"},"children":[]}]}]},{"data":{"text":"Phase 1"},"children":[{"data":{"text":"资料提交（T-10 天前）"},"children":[{"data":{"text":"配色分类：准备阶段（低饱和度淡蓝色 🩵）"},"children":[]}]}]},{"data":{"text":"Phase 2"},"children":[{"data":{"text":"CCB 评审（T-7 天前）"},"children":[{"data":{"text":"配色分类：评审/审批节点（低饱和度淡橙色 🧡）"},"children":[]}]}]},{"data":{"text":"Phase 3"},"children":[{"data":{"text":"CIM 开发自测（T-7 -> T-1）"},"children":[{"data":{"text":"配色分类：准备阶段（低饱和度淡蓝色 🩵）","priority":4},"children":[]}]}]},{"data":{"text":"Phase 4"},"children":[{"data":{"text":"NB 借机申请（T-7 前交）"},"children":[{"data":{"text":"配色分类：评审/审批节点（低饱和度淡橙色 🧡）"},"children":[]}]}]},{"data":{"text":"Phase 5"},"children":[{"data":{"text":"现场联合调试（T + 1 起借机）"},"children":[{"data":{"text":"配色分类：生产挂接（低饱和度淡绿色 💚）"},"children":[]}]}]},{"data":{"text":"Phase 6"},"children":[{"data":{"text":"生产挂回 + 24h 值守（生产恢复）"},"children":[{"data":{"text":"配色分类：生产挂接（低饱和度淡绿色 💚）"},"children":[]}]}]},{"data":{"text":"Phase 7"},"children":[{"data":{"text":"收尾归档 (≥ 5 年)（变更关闭）"},"children":[{"data":{"text":"配色分类：变更关闭（低饱和度淡紫色 💜）"},"children":[]}]}]},{"data":{"text":"图例与配色调整建议（柔和莫兰迪色系）"},"children":[{"data":{"text":"准备阶段：莫兰迪蓝（7FA9D6）"},"children":[]},{"data":{"text":"评审/审批节点：暖沙橙（#E8B476）"},"children":[]},{"data":{"text":"生产挂接：草木绿（#9CC080）"},"children":[]},{"data":{"text":"变更关闭：烟熏紫（#A389D4）"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}